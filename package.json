{
  "name": "@_linked/messaging",
  "version": "0.1.0",
  "description": "A shape-agnostic, transport-agnostic LINKED messaging engine \u2014 the Messaging seam, an in-memory store, and a themeable chat client. Transports (e.g. @_linked/matrix) implement the same interface.",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-cm/messaging.git"
  },
  "homepage": "https://github.com/linked-cm/messaging#readme",
  "bugs": {
    "url": "https://github.com/linked-cm/messaging/issues"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/package.ts",
    "./src/MessageClient.module.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "npm exec linked dev",
    "build": "npm exec linked build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "npm exec linked build production",
    "postpublish": "npm exec linked register"
  },
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./package": {
      "types": "./lib/esm/package.d.ts",
      "development": "./src/package.ts",
      "import": "./lib/esm/package.js",
      "require": "./lib/cjs/package.js"
    },
    "./styles.css": {
      "development": "./src/MessageClient.module.css",
      "import": "./lib/esm/MessageClient.module.css",
      "require": "./lib/cjs/MessageClient.module.css"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "2.14.4",
    "@_linked/css": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@_linked/cli": "1.11.1",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "linked",
    "messaging",
    "chat",
    "rdf",
    "semantic-web"
  ]
}
