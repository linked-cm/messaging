{
  "name": "@linked.cm/messaging",
  "version": "0.1.0",
  "description": "A shape-agnostic, transport-agnostic LINKED messaging engine — the Messaging seam, an in-memory store, and a themeable chat client. Transports (e.g. @linked.cm/matrix) implement the same interface.",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-cm/messaging.git"
  },
  "homepage": "https://github.com/linked-cm/messaging#readme",
  "bugs": {
    "url": "https://github.com/linked-cm/messaging/issues"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/package.ts",
    "./src/MessageClient.module.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "npm exec linked dev",
    "build": "npm exec linked build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./package": {
      "types": "./lib/esm/package.d.ts",
      "import": "./lib/esm/package.js",
      "require": "./lib/cjs/package.js"
    },
    "./styles.css": {
      "import": "./lib/esm/MessageClient.module.css",
      "require": "./lib/cjs/MessageClient.module.css"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "^2.25.0",
    "@_linked/css": "0.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@_linked/cli": "1.39.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0"
  },
  "keywords": [
    "linked",
    "messaging",
    "chat",
    "rdf",
    "semantic-web"
  ]
}
